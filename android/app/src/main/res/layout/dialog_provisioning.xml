<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/provision_header"
            android:textColor="#171D1C"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/provision_hint"
            android:textColor="#54627A"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/soft_card_background"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_access_title"
                android:textColor="#1E3A8A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/ap_ssid_title"
                android:textColor="#6D7A77"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/provisionDeviceApSsidInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_soft_background"
                android:hint="@string/device_ap_ssid_hint"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/input_text_dark_blue"
                android:textColorHint="@color/input_hint_blue" />

            <Button
                android:id="@+id/provisionOpenWifiSettingsButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/button_soft_neutral"
                android:text="@string/open_wifi_settings_button"
                android:textColor="#1D4ED8" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/soft_card_background"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_wifi_title"
                android:textColor="#1E3A8A"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/home_wifi_title"
                android:textColor="#6D7A77"
                android:textSize="11sp"
                android:textStyle="bold" />

            <AutoCompleteTextView
                android:id="@+id/provisionHomeWifiSsidInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_soft_background"
                android:clickable="true"
                android:dropDownVerticalOffset="4dp"
                android:focusable="false"
                android:hint="@string/home_wifi_ssid_hint"
                android:inputType="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/input_text_dark_blue"
                android:textColorHint="@color/input_hint_blue" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/password_title"
                android:textColor="#6D7A77"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/provisionHomeWifiPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_soft_background"
                android:hint="@string/home_wifi_password_hint"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/input_text_dark_blue"
                android:textColorHint="@color/input_hint_blue" />

            <Button
                android:id="@+id/provisionRefreshWifiListButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/button_soft_neutral"
                android:text="@string/refresh_wifi_button"
                android:textColor="#283540" />

            <Button
                android:id="@+id/provisionSendButton"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/button_primary_cta"
                android:text="@string/provision_wifi_button"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <Button
            android:id="@+id/provisionCloseButton"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/button_soft_neutral"
            android:text="×"
            android:textColor="#6D7A77"
            android:textSize="26sp" />

    </LinearLayout>
</ScrollView>
