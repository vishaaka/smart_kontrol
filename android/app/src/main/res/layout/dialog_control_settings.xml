<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/control_settings_title"
            android:textColor="#171D1C"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/soft_card_background"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/device_identity_title"
                android:textColor="#243634"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/label_title"
                android:textColor="#6D7A77"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/settingsDeviceNameInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_soft_background"
                android:hint="@string/device_name_hint"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/input_text_dark_blue"
                android:textColorHint="@color/input_hint_blue" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/ip_title"
                android:textColor="#6D7A77"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/settingsBaseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_soft_background"
                android:hint="@string/base_url_hint"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/input_text_dark_blue"
                android:textColorHint="@color/input_hint_blue" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/token_title"
                android:textColor="#6D7A77"
                android:textSize="11sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/settingsTokenInput"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_soft_background"
                android:hint="@string/token_hint"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/input_text_dark_blue"
                android:textColorHint="@color/input_hint_blue" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/soft_card_background"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/primary_relay_label"
                android:textColor="#171D1C"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/settingsPrimaryRelaySpinner"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_soft_background" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/settingsRelay2VisibleSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/relay2_visible_label"
                android:textColor="#171D1C" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/soft_card_background"
            android:elevation="4dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/section_header_primary"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp"
                android:text="@string/relay1_config_title"
                android:textColor="#1D4ED8"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_title"
                    android:textColor="#6D7A77"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/settingsRelay1LabelInput"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_soft_background"
                    android:hint="@string/relay_label_hint"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/input_text_dark_blue"
                    android:textColorHint="@color/input_hint_blue" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/mode_title"
                    android:textColor="#6D7A77"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/settingsRelay1ModeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_soft_background" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/duration_title"
                    android:textColor="#6D7A77"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/settingsRelay1PulseInput"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_soft_background"
                    android:hint="@string/pulse_hint"
                    android:inputType="number"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/input_text_dark_blue"
                    android:textColorHint="@color/input_hint_blue" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/soft_card_background"
            android:elevation="4dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/section_header_secondary"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp"
                android:text="@string/relay2_config_title"
                android:textColor="#4338CA"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_title"
                    android:textColor="#6D7A77"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/settingsRelay2LabelInput"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_soft_background"
                    android:hint="@string/relay_label_hint"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/input_text_dark_blue"
                    android:textColorHint="@color/input_hint_blue" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/mode_title"
                    android:textColor="#6D7A77"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/settingsRelay2ModeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_soft_background" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/duration_title"
                    android:textColor="#6D7A77"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/settingsRelay2PulseInput"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_soft_background"
                    android:hint="@string/pulse_hint"
                    android:inputType="number"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/input_text_dark_blue"
                    android:textColorHint="@color/input_hint_blue" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/settingsPushConfigButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/button_primary_cta"
            android:text="@string/push_config_button"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settingsSaveLocalButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_weight="1"
                android:background="@drawable/button_soft_neutral"
                android:text="@string/save_local_button"
                android:textColor="#1E3A8A" />

            <Button
                android:id="@+id/settingsCloseButton"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/button_soft_warm"
                android:text="@string/close_button"
                android:textColor="#A93232" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
